---
import Base from '../layouts/Base.astro';
import Photo from './Photo.astro';
import ProductCard from './ProductCard.astro';
import { ui, paths, type Lang } from '../i18n/ui';
import { productPhoto, lineKeys } from '../lib/photos';
import { products } from '../lib/catalog';

const { lang, product: x } = Astro.props as { lang: Lang; product: Record<string, string> };
const t = ui[lang];
const p = paths[lang];
const L = (k: string) => x[`${k}_${lang}`];
const name = L('nombre');
const lineIndex = lineKeys.indexOf(x.linea as (typeof lineKeys)[number]);
const split = (s: string) => s.split(',').map((v) => v.trim()).filter(Boolean);
const colors = split(x.colores);
const sizes = split(x.tallas);
const gallery = [productPhoto(x), x.foto_2, x.foto_3].map((f) => f || null);
const details = [
  [t.product.composition, L('composicion')],
  [t.product.measures, x.medidas],
  [t.product.time, L('tiempo_elaboracion')],
  [t.product.care, L('cuidados')],
].filter(([, v]) => v);
const related = products.filter((r) => r.linea === x.linea && r.id !== x.id).slice(0, 4);
// Muestra de color aproximada por nombre; si no se conoce, un neutro.
const swatch: Record<string, string> = {
  crudo: '#ece4d4', blanco: '#f6f4ef', 'blanco y negro': 'linear-gradient(135deg,#f6f4ef 50%,#151515 50%)', negro: '#151515', gris: '#9b9a97', 'gris carbón': '#3b3b3b',
  pomelo: '#d67f56', beige: '#d8c6a8', chocolate: '#5a3a28', café: '#6b4a33', terracota: '#b5603f', tierra: '#9a6b45',
  'verde musgo': '#5f6b3a', verde: '#4f7a4a', salvia: '#a3b18a', 'verde lima': '#b5cf4a', petróleo: '#1f4d5a', 'rosa palo': '#e3b9b3', rosa: '#e2a3a8', fucsia: '#c2307a',
};
---
<Base lang={lang} page="collection" slug={x.slug} title={name}>
  <nav class="wrap crumbs" aria-label="Breadcrumb">
    <a href={p.collection}>{t.collection.title}</a>
    <span aria-hidden="true">/</span>
    <a href={`${p.collection}#${x.linea}`}>{t.lines.items[lineIndex]}</a>
  </nav>
  <article class="wrap item">
    <div class="gallery" aria-label={t.product.gallery}>
      {gallery.map((src, i) => (
        <span class="zoom"><Photo src={src} alt={i === 0 ? name : ''} widths={[500, 1000]} sizes="(min-width: 52rem) 50vw, 100vw" loading={i === 0 ? 'eager' : 'lazy'} /></span>
      ))}
    </div>

    <div class="info">
      <h1>{name}</h1>
      <p class="price">S/ {x.precio_soles}</p>
      <p class="desc">{L('descripcion')}</p>

      <form id="add" data-id={x.id}>
        {colors.length > 0 && (
          <fieldset>
            <legend>{t.product.color}: <span data-chosen>{colors[0]}</span></legend>
            <div class="swatches">
              {colors.map((c, i) => (
                <label class="sw" title={c}>
                  <input class="sr" type="radio" name="color" value={c} checked={i === 0} />
                  <span class="dot" style={`background:${swatch[c.toLowerCase()] ?? '#c9c4bc'}`}></span>
                  <span class="sr">{c}</span>
                </label>
              ))}
            </div>
          </fieldset>
        )}
        {sizes.length > 0 && (
          <fieldset>
            <legend>{t.product.size}</legend>
            <div class="sizes">
              {sizes.map((s, i) => (
                <label class="chip"><input class="sr" type="radio" name="talla" value={s} checked={i === 0} /><span>{s}</span></label>
              ))}
            </div>
          </fieldset>
        )}
        <div class="buy">
          <div class="stepper" role="group" aria-label={t.product.qty}>
            <button type="button" data-step="-1" aria-label={t.product.less}>−</button>
            <input type="number" name="cantidad" value="1" min="1" max="20" aria-label={t.product.qty} />
            <button type="button" data-step="1" aria-label={t.product.more}>+</button>
          </div>
          <button class="btn add" type="submit">{t.product.add}</button>
        </div>
        <p class="ok" role="status"><span hidden>{t.product.added} <a href={p.list}>{t.product.goList}</a></span></p>
        <p class="note">{t.product.note}</p>
      </form>

      <div class="details">
        {details.map(([k, v], i) => (
          <details open={i === 0}>
            <summary>{k}</summary>
            <p>{v}</p>
          </details>
        ))}
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="on-smoke">
      <div class="wrap related">
        <h2 class="sec-title">{t.product.related}</h2>
        <ul>{related.map((r) => <li><ProductCard lang={lang} product={r} /></li>)}</ul>
      </div>
    </section>
  )}
</Base>

<script>
  import { addItem } from '../lib/list';
  const form = document.getElementById('add') as HTMLFormElement;
  const qty = form.querySelector<HTMLInputElement>('input[name=cantidad]')!;
  const chosen = form.querySelector<HTMLElement>('[data-chosen]');

  form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
    b.addEventListener('click', () => { qty.value = String(Math.min(20, Math.max(1, (Number(qty.value) || 1) + Number(b.dataset.step)))); }));
  form.addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.name === 'color' && chosen) chosen.textContent = el.value;
  });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    addItem({ id: form.dataset.id!, color: String(d.get('color') ?? ''), talla: String(d.get('talla') ?? ''), cantidad: Math.max(1, Number(d.get('cantidad')) || 1) });
    const ok = form.querySelector<HTMLElement>('.ok span')!;
    ok.hidden = false;
    ok.classList.remove('pop'); void ok.offsetWidth; ok.classList.add('pop'); // reinicia la animación si se agrega otra vez
  });
</script>

<style>
  .crumbs { display: flex; gap: 0.6rem; padding-top: 1.5rem; font-size: 0.95rem; }
  .crumbs a { text-decoration: none; opacity: 0.8; }
  .crumbs a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 4px; }

  .item { display: grid; gap: 2rem; padding-block: 1.25rem clamp(3rem, 7vw, 5rem); }
  .gallery { display: grid; gap: 0.6rem; grid-template-columns: 1fr 1fr; }
  .gallery img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; display: block; }
  .gallery .zoom:first-child { grid-column: 1 / -1; }
  .gallery .zoom:first-child img { aspect-ratio: 4 / 5; }

  .info { display: grid; gap: 1.1rem; align-content: start; }
  .price { font-family: var(--font-title); font-size: var(--step-1); color: var(--color-ink); }
  .desc { padding-bottom: 0.4rem; }

  form { display: grid; gap: 1.4rem; padding-block: 1.4rem; border-block: 1px solid var(--line); }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  legend { padding: 0; margin-bottom: 0.65rem; color: var(--color-ink); }
  legend span { color: var(--color-text); }
  .swatches, .sizes { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .sw { cursor: pointer; display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; border: 1px solid transparent; transition: border-color 0.2s, transform 0.2s var(--ease); }
  .sw:hover { transform: scale(1.06); }
  .dot { width: 1.8rem; height: 1.8rem; border-radius: 50%; box-shadow: inset 0 0 0 1px rgb(5 5 5 / 0.15); }
  .sw:has(:checked) { border-color: var(--color-ink); }
  .sw:has(:focus-visible), .chip:has(:focus-visible) { outline: 2px solid var(--color-ink); outline-offset: 2px; }
  .chip span { display: grid; place-items: center; min-width: 3rem; height: 2.6rem; padding: 0 0.9rem; border: 1px solid var(--line); cursor: pointer; transition: border-color 0.2s, background-color 0.2s; }
  .chip:hover span { border-color: rgb(5 5 5 / 0.45); }
  .chip:has(:checked) span { border-color: var(--color-ink); background: var(--color-ink-soft); color: var(--color-white); }

  .buy { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .stepper { display: inline-grid; grid-template-columns: 2.6rem 3rem 2.6rem; border: 1px solid var(--line); height: 3rem; }
  .stepper button { font: inherit; font-size: 1.2rem; background: none; border: 0; cursor: pointer; color: var(--color-ink); transition: background-color 0.2s; }
  .stepper button:hover { background: rgb(5 5 5 / 0.06); }
  .stepper input { font: inherit; text-align: center; border: 0; background: transparent; width: 100%; -moz-appearance: textfield; appearance: textfield; color: var(--color-ink); }
  .stepper input::-webkit-inner-spin-button { -webkit-appearance: none; }
  .add { flex: 1 1 12rem; height: 3rem; padding-block: 0; text-align: center; }
  .ok { min-height: 1.5em; margin-top: -0.6rem; font-size: 0.95rem; }
  .ok a { color: var(--color-ink); }
  .note { font-size: 0.9rem; opacity: 0.85; margin-top: -0.8rem; }
  @media (prefers-reduced-motion: no-preference) {
    .pop { animation: pop 0.5s var(--ease); display: inline-block; }
    @keyframes pop { from { opacity: 0; transform: translateY(6px); } }
  }

  .details details { border-bottom: 1px solid var(--line); }
  .details summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; padding: 0.85rem 0; font-family: var(--font-title); color: var(--color-ink); }
  .details summary::-webkit-details-marker { display: none; }
  .details summary::after { content: '+'; transition: transform 0.3s var(--ease); }
  .details details[open] summary::after { transform: rotate(45deg); }
  .details p { padding-bottom: 0.9rem; }

  .on-smoke { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .related { display: grid; gap: 2rem; }
  .related ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.75rem 1rem; }

  @media (min-width: 52rem) {
    .item { grid-template-columns: 1.15fr 1fr; gap: clamp(3rem, 6vw, 5.5rem); align-items: start; }
    .info { position: sticky; top: 7.5rem; }
    .related ul { grid-template-columns: repeat(4, 1fr); }
  }
</style>
