---
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Photo from './Photo.astro';
import { ui, paths, contact, type Lang } from '../i18n/ui';
import { products } from '../lib/catalog';
import { lineKeys, linePhoto, productPhoto } from '../lib/photos';
import dorado from '../assets/estilo/dorado.webp';
import teal from '../assets/estilo/chompa-teal.webp';
import amigas from '../assets/estilo/amigas.webp';
import topCrochet from '../assets/estilo/top-crochet.webp';
import girasolCrudo from '../assets/estilo/cardigan-girasol.webp';
import girasolVerde from '../assets/estilo/girasol-verde.webp';
import margaritas from '../assets/estilo/margaritas.webp';
import reconocimiento from '../assets/reconocimiento.webp';

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const p = paths[lang];
const featured = products.filter((x) => x.destacado === 'SI').slice(0, 4);
const name = (x: Record<string, string>) => (lang === 'es' ? x.nombre_es : x.nombre_en);
// Tres collages de 3 a 5 fotos; cada uno define su grilla en el CSS (.c1, .c2, .c3).
const collages: ImageMetadata[][] = [
  [dorado, teal, girasolCrudo, topCrochet],
  [amigas, margaritas, girasolVerde, topCrochet, teal],
  [margaritas, girasolVerde, dorado],
];
---
<Base lang={lang} page="home">
  <section class="hero">
    <div class="slides" id="slides" role="group" aria-label={t.hero.label}>
      {collages.map((imgs, i) => (
        <div class={`collage c${i + 1}`} aria-hidden="true">
          {imgs.map((src, j) => (
            <Photo src={src} alt="" class={`p${j + 1}`} widths={[400, 800]} sizes="(min-width: 52rem) 30vw, 50vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 && j === 0 ? 'high' : undefined} />
          ))}
        </div>
      ))}
      <div class="overlay rise">
        <h1>{t.hero.title}</h1>
        <div class="actions">
          <a class="btn" href={p.collection}>{t.hero.cta}</a>
          <a class="btn light" href={p.catalog}>{t.hero.catalog}</a>
        </div>
      </div>
    </div>
    <button class="pause" type="button" id="pause" aria-pressed="false" data-play={t.hero.play} data-pause={t.hero.pause}>{t.hero.pause}</button>
  </section>

  <section class="wrap lines">
    <h2 class="sec-title">{t.lines.title}</h2>
    <ul>
      {lineKeys.map((key, i) => (
        <li>
          <a class="zoom" href={`${p.collection}#${key}`}>
            <Photo src={linePhoto[key]} alt={t.alt[key]} widths={[300, 600]} sizes="(min-width: 52rem) 18vw, 50vw" />
            <span class="label">
              <span class="name">{t.lines.items[i]}</span>
              <span class="btn">{t.lines.more}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="on-smoke">
    <div class="wrap featured">
      <div class="lead">
        <span class="zoom"><Photo src={teal} alt={t.alt.chompas} widths={[500, 1000]} sizes="(min-width: 52rem) 45vw, 100vw" /></span>
        <div class="note">
          <h2>{t.featured.title}</h2>
          <p>{t.featured.text}</p>
          <a class="btn ghost" href={p.collection}>{t.featured.cta}</a>
        </div>
      </div>
      <ul aria-label={t.featured.label}>
        {featured.map((x) => (
          <li>
            <a class="zoom" href={`${p.collection}/${x.slug}`}>
              <Photo src={productPhoto(x)} alt={name(x)} widths={[300, 600]} sizes="(min-width: 52rem) 22vw, 50vw" />
              <span class="tip" aria-hidden="true">{name(x)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap trust">
    <div class="mosaic">
      <span class="zoom big"><Photo src={reconocimiento} alt={t.trust.alt} widths={[500, 1000]} sizes="(min-width: 52rem) 35vw, 100vw" /></span>
      <span class="zoom"><Photo src={girasolVerde} alt="" widths={[300, 600]} sizes="(min-width: 52rem) 15vw, 50vw" /></span>
      <span class="zoom"><Photo src={margaritas} alt="" widths={[300, 600]} sizes="(min-width: 52rem) 15vw, 50vw" /></span>
    </div>
    <div class="copy">
      <h2>{t.trust.title}</h2>
      <p>{t.trust.text}</p>
      <dl>
        {t.trust.facts.map((f) => (<div><dt>{f.title}</dt><dd>{f.text}</dd></div>))}
      </dl>
      <a class="more" href={contact.produce} target="_blank" rel="noopener noreferrer">{t.trust.link}</a>
    </div>
  </section>
</Base>

<script>
  // Pausa del carrusel (WCAG 2.2.2). Las animaciones son CSS; aquí solo se detienen o reanudan.
  const btn = document.getElementById('pause') as HTMLButtonElement;
  const slides = document.getElementById('slides')!;
  btn.addEventListener('click', () => {
    const paused = slides.classList.toggle('paused');
    btn.setAttribute('aria-pressed', String(paused));
    btn.textContent = paused ? btn.dataset.play! : btn.dataset.pause!;
  });
</script>

<style>
  section { padding-block: clamp(2.5rem, 7vw, 5.5rem); }
  img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Hero: franja #212121 a todo el ancho; collages que se funden; título y botones dentro, abajo al centro */
  .hero { position: relative; background: var(--color-ink-soft); padding: clamp(1rem, 3vw, 2.25rem) var(--gutter) 3.25rem; }
  .slides { position: relative; max-width: 72rem; margin-inline: auto; aspect-ratio: 4 / 5; overflow: hidden; }
  .collage { position: absolute; inset: 0; display: grid; gap: 5px; background: var(--color-ink-soft); opacity: 0; }
  .collage:first-child { opacity: 1; }
  .collage img { object-position: 50% 30%; min-width: 0; min-height: 0; }

  /* Móvil: las tres primeras fotos */
  .collage { grid-template: 'p1 p2' minmax(0, 1fr) 'p1 p3' minmax(0, 1fr) / 1.15fr 1fr; }
  .p1 { grid-area: p1; } .p2 { grid-area: p2; } .p3 { grid-area: p3; } .p4 { grid-area: p4; } .p5 { grid-area: p5; }
  .collage .p4, .collage .p5 { display: none; }

  .overlay { position: absolute; inset: auto 0 0; z-index: 1; display: grid; justify-items: center; gap: 0.7rem; padding: 2.5rem 0.75rem 1rem; text-align: center; background: linear-gradient(transparent, rgb(5 5 5 / 0.62)); }
  .overlay h1 { color: var(--color-white); font-size: var(--step-1); text-shadow: 0 1px 12px rgb(5 5 5 / 0.45); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; }
  .overlay .btn { padding: 0.45rem 1rem; font-size: 0.95rem; }
  .btn.light { background: rgb(250 248 245 / 0.08); color: var(--color-white); border-color: rgb(250 248 245 / 0.55); backdrop-filter: blur(4px); }
  .btn.light:hover { background: rgb(250 248 245 / 0.18); }

  .pause { position: absolute; right: var(--gutter); bottom: 0.75rem; font: inherit; font-size: 0.8rem; color: var(--color-white); background: transparent; border: 1px solid rgb(250 248 245 / 0.25); padding: 0.15rem 0.7rem; cursor: pointer; opacity: 0.75; transition: opacity 0.25s, background-color 0.25s; }
  .pause:hover { opacity: 1; background: rgb(250 248 245 / 0.08); }

  /* Fundido entre collages (21 s, 7 s cada uno) y un acercamiento lento de las fotos */
  @media (prefers-reduced-motion: no-preference) {
    .collage { animation: xfade 21s infinite; }
    .collage:first-child { opacity: 0; }
    .c2 { animation-delay: 7s; }
    .c3 { animation-delay: 14s; }
    .collage img { animation: drift 21s infinite linear; animation-delay: inherit; }
    .paused .collage, .paused .collage img { animation-play-state: paused; }
    @keyframes xfade { 0% { opacity: 0; } 6% { opacity: 1; } 33.3% { opacity: 1; } 40% { opacity: 0; } 100% { opacity: 0; } }
    @keyframes drift { from { transform: scale(1); } 40% { transform: scale(1.06); } to { transform: scale(1.06); } }
  }
  @media (prefers-reduced-motion: reduce) { .pause { display: none; } }

  .lines { display: grid; gap: 2rem; }
  .lines ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
  .lines li:first-child { grid-column: 1 / -1; }
  .lines li:first-child img { aspect-ratio: 4 / 3; }
  .lines a { position: relative; color: var(--color-white); text-decoration: none; }
  .lines img { aspect-ratio: 3 / 4; }
  .label { position: absolute; inset: auto 0 0; display: grid; justify-items: center; gap: 0.5rem; padding: 3rem 0.5rem 1rem; text-align: center; background: linear-gradient(transparent, rgb(5 5 5 / 0.6)); }
  .label .name { font-family: var(--font-title); font-size: var(--step-1); }
  .label .btn { padding: 0.3rem 1rem; font-size: 0.85rem; }

  /* Destacados: una foto grande con texto breve + las prendas más pequeñas */
  .featured { display: grid; gap: 1.5rem; }
  .lead { position: relative; }
  .lead img { aspect-ratio: 3 / 4; }
  .note { display: grid; gap: 0.7rem; justify-items: start; background: var(--color-smoke); padding: 1.1rem 1.25rem 1.25rem; margin: -3rem 0.75rem 0; position: relative; box-shadow: 0 18px 34px -26px rgb(5 5 5 / 0.6); }
  .note p { font-size: var(--step--1); }
  .featured ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; align-content: start; }
  .featured ul a { position: relative; }
  .featured ul img { aspect-ratio: 3 / 4; }
  .tip { position: absolute; inset: auto 0 0; padding: 0.6rem 0.75rem; font-family: var(--font-title); font-size: 1rem; color: var(--color-ink); background: rgb(232 232 230 / 0.92); transform: translateY(100%); transition: transform 0.35s var(--ease); }
  .featured ul a:hover .tip, .featured ul a:focus-visible .tip { transform: translateY(0); }

  /* Respaldo: mosaico con la foto del reconocimiento + datos de la nota de PRODUCE */
  .trust { display: grid; gap: 2rem; align-items: center; }
  .mosaic { display: grid; grid-template-columns: 1.6fr 1fr; grid-template-rows: 1fr 1fr; gap: 0.6rem; }
  .mosaic .big { grid-row: 1 / -1; }
  .mosaic img { min-height: 0; }
  .mosaic .big img { aspect-ratio: 1; }
  .copy { display: grid; gap: 1.1rem; justify-items: start; }
  dl { margin: 0; display: grid; gap: 0.8rem; }
  dl div { border-top: 1px solid var(--line); padding-top: 0.7rem; }
  dt { font-family: var(--font-title); font-size: 1.1rem; color: var(--color-ink); }
  dd { margin: 0; }
  .more { color: var(--color-ink); text-underline-offset: 4px; }

  @media (min-width: 52rem) {
    .slides { aspect-ratio: 16 / 7.5; }
    .c1 { grid-template: 'p1 p2 p3' minmax(0, 1fr) 'p1 p2 p4' minmax(0, 1fr) / 1fr 1.35fr 0.9fr; }
    .c2 { grid-template: 'p1 p1 p3 p4' minmax(0, 1fr) 'p2 p2 p3 p5' minmax(0, 1fr) / 1fr 0.7fr 1fr 0.9fr; }
    .c3 { grid-template: 'p1 p2 p3' minmax(0, 1fr) / 1.3fr 1fr 1fr; }
    .collage .p4, .collage .p5 { display: block; }
    .overlay { padding: 7rem 1rem 2rem; gap: 0.9rem; }
    .overlay .btn { padding: 0.7rem 1.6rem; font-size: inherit; }
    .lines ul { grid-template-columns: repeat(5, 1fr); }
    .lines li:first-child { grid-column: auto; }
    .lines li:first-child img { aspect-ratio: 3 / 4; }
    .label .name { font-size: 1.35rem; }
    .featured { grid-template-columns: 1fr 1fr; gap: 0.75rem; align-items: start; }
    .note { position: absolute; left: 1.25rem; bottom: 1.25rem; margin: 0; max-width: 24rem; }
    .trust { grid-template-columns: 1.1fr 1fr; gap: clamp(2.5rem, 6vw, 5rem); }
  }
</style>
