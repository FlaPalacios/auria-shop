---
import '../styles/global.css';
import { ui, paths, contact, type Lang, type Page } from '../i18n/ui';
import { waLink } from '../lib/whatsapp';

type Props = { lang: Lang; page: Page; title?: string; slug?: string; bare?: boolean };
const { lang, page, title, slug, bare = false } = Astro.props;
const t = ui[lang];
const p = paths[lang];
const other = lang === 'es' ? 'en' : 'es';
const href = (l: Lang) => paths[l][page] + (slug ? `/${slug}` : '');
const ext = { target: '_blank', rel: 'noopener noreferrer' };
const social = [
  { name: 'Instagram', url: contact.instagram, icon: '/img/instagram.png' },
  { name: 'Facebook', url: contact.facebook, icon: '/img/facebook.png' },
  { name: 'TikTok', url: contact.tiktok, icon: '/img/tiktok.png' },
  { name: 'WhatsApp', url: waLink(t.wa.hello), icon: '/img/whatsapp.png' },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · Auria` : t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="icon" href="/brand/logo-auria-negro.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="es" href={href('es')} />
    <link rel="alternate" hreflang="en" href={href('en')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Kurale&display=swap" rel="stylesheet" />
    <script is:inline>
      // Imagen rota → placeholder. data-fallback evita el bucle si el placeholder también fallara.
      document.addEventListener('error', function (e) {
        var img = e.target;
        if (!img || img.tagName !== 'IMG' || img.hasAttribute('data-fallback')) return;
        img.setAttribute('data-fallback', '');
        img.removeAttribute('srcset');
        img.src = '/img/placeholder.svg';
      }, true);
    </script>
  </head>
  <body>
    {!bare && (
      <Fragment>
        <p class="band">{t.band}</p>
        <header class="top" id="top">
        <div class="wrap bar">
          <a class="logo" href={p.home}><img src="/brand/logo-auria-negro.svg" alt="Auria" width="120" height="66" /></a>
          <div class="utils">
            <a href={href(other)} lang={other} class="lang">{lang === 'es' ? 'ESP / EN' : 'EN / ESP'}</a>
            <a href={p.list}>{t.nav.list} <span data-list-count></span></a>
          </div>
          <nav aria-label={t.nav.label}>
            <a href={p.collection} aria-current={page === 'collection' ? 'page' : undefined}>{t.nav.collection}</a>
            <a href={p.story} aria-current={page === 'story' ? 'page' : undefined}>{t.nav.story}</a>
            <a href={p.custom} aria-current={page === 'custom' ? 'page' : undefined}>{t.nav.custom}</a>
            <a href={p.contact} aria-current={page === 'contact' ? 'page' : undefined}>{t.nav.contact}</a>
          </nav>
        </div>
        </header>
      </Fragment>
    )}
    <main><slot /></main>
    {!bare && (
      <footer class="foot">
        <div class="wrap cols">
          <div class="about">
            <img src="/brand/logo-auria-blanco.svg" alt="Auria" width="130" height="72" />
            <p>{t.footer.about}</p>
            <ul class="social" aria-label={t.footer.social}>
              {social.map((s) => <li><a href={s.url} {...ext}><img src={s.icon} alt={s.name} width="24" height="24" /></a></li>)}
            </ul>
          </div>
          <div>
            <h2>{t.footer.shop}</h2>
            <ul>
              <li><a href={p.collection}>{t.nav.collection}</a></li>
              <li><a href={p.catalog}>{t.nav.catalog}</a></li>
              <li><a href={p.custom}>{t.nav.custom}</a></li>
              <li><a href={p.list}>{t.nav.list}</a></li>
            </ul>
          </div>
          <div>
            <h2>{t.footer.brand}</h2>
            <ul>
              <li><a href={p.story}>{t.nav.story}</a></li>
              <li><a href={p.babyAlpaca}>{t.nav.babyAlpaca}</a></li>
              <li><a href={p.recognition}>{t.nav.recognition}</a></li>
            </ul>
          </div>
          <div>
            <h2>{t.footer.contact}</h2>
            <ul>
              <li><a href={waLink(t.wa.hello)} {...ext}>WhatsApp {contact.whatsapp}</a></li>
              <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
              <li>{t.contactPage.workshopText}</li>
            </ul>
          </div>
        </div>
        <p class="wrap rights">© {new Date().getFullYear()} {t.footer.rights}</p>
      </footer>
    )}
    <script>
      import { readList, writeList } from '../lib/list';
      writeList(readList()); // pinta el contador del menú
      // Encabezado fijo: se comprime al bajar.
      const top = document.getElementById('top');
      if (top) {
        const onScroll = () => top.classList.toggle('small', window.scrollY > 80);
        addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }
    </script>
  </body>
</html>

<style>
  .band { margin: 0; max-width: none; background: var(--color-ink-soft); color: var(--color-white); text-align: center; font-size: 0.9rem; letter-spacing: 0.06em; padding: 0.4rem var(--gutter); }
  .top { position: sticky; top: 0; z-index: 20; background: rgb(227 223 216 / 0.94); backdrop-filter: blur(8px); transition: box-shadow 0.35s; }
  .top.small { box-shadow: 0 8px 22px -18px rgb(5 5 5 / 0.6); }
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; row-gap: 0.75rem; padding-block: 1rem 1.15rem; transition: padding 0.35s var(--ease), row-gap 0.35s var(--ease); }
  .small .bar { padding-block: 0.45rem 0.55rem; row-gap: 0.3rem; }
  .logo { grid-column: 2; }
  .bar img { height: auto; width: clamp(96px, 12vw, 132px); transition: width 0.35s var(--ease); }
  .small .bar img { width: clamp(70px, 8vw, 86px); }
  .utils { grid-column: 3; justify-self: end; display: flex; gap: 1.25rem; font-size: 0.95rem; }
  nav { grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem 2.25rem; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.9rem; }
  a { text-decoration: none; }
  a:hover, [aria-current] { text-decoration: underline; text-underline-offset: 4px; }
  .lang { opacity: 0.75; }

  .foot { background: var(--color-ink-soft); color: var(--color-white); --color-text: rgb(250 248 245 / 0.85); padding-block: 3.5rem 1.5rem; font-size: 0.95rem; }
  .cols { display: grid; gap: 2.25rem; }
  .foot h2 { font-size: 1.15rem; color: var(--color-white); margin-bottom: 0.75rem; }
  .foot ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .foot a { opacity: 0.85; transition: opacity 0.2s; }
  .foot a:hover { opacity: 1; }
  .about { display: grid; gap: 1rem; justify-items: start; }
  .about > img { width: 130px; height: auto; }
  .social { display: flex !important; gap: 1.1rem !important; }
  .social a { display: block; opacity: 0.8; transition: opacity 0.2s, transform 0.2s; }
  .social a:hover { opacity: 1; transform: translateY(-1px); }
  .social img { width: 24px; height: 24px; }
  .rights { margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid rgb(250 248 245 / 0.15); font-size: 0.85rem; opacity: 0.7; max-width: 80rem; }

  @media (min-width: 52rem) {
    .cols { grid-template-columns: 1.6fr 1fr 1fr 1.3fr; }
  }
  @media (max-width: 30rem) {
    .band { font-size: 0.75rem; letter-spacing: 0.03em; }
    .bar { grid-template-columns: auto 1fr; }
    .logo { grid-column: 1; }
    .utils { grid-column: 2; }
    nav { display: grid; grid-template-columns: 1fr 1fr; text-align: center; gap: 0.5rem 1rem; font-size: 0.85rem; }
  }
</style>
