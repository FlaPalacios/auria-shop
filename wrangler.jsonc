{
  // Sitio estático servido por Workers static assets: sin "main" porque no hay código de Worker.
  // `public/_headers` llega a dist/ y Cloudflare lo aplica igual que en Pages.
  "name": "auria-shop",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./dist",
    // Sin esto, /coleccion redirige 307 a /coleccion/ y el canonical apunta a una redireccion.
    "html_handling": "drop-trailing-slash"
  }
}
